# Muscle Power Gym — Apache / cPanel
# Vite copies this file into dist/ on build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep /api for a backend on the same host
  RewriteRule ^api/ - [L]

  # Unknown paths load the app (so /rules, /weight-loss etc. work on refresh)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
</IfModule>
